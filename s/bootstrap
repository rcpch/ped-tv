#!/usr/bin/env bash
# Run once after cloning to get the dev environment ready.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "==> Copying envs/.env.example to envs/.env (if not already present)..."
if [[ ! -f "$ROOT/envs/.env" ]]; then
  cp "$ROOT/envs/.env.example" "$ROOT/envs/.env"
  echo "    envs/.env created — edit it if needed."
else
  echo "    envs/.env already exists, skipping."
fi

echo "==> Building Docker images..."
docker compose build

echo "==> Starting postgres and garage..."
docker compose up -d postgres garage

echo "==> Waiting for postgres..."
until docker compose exec postgres pg_isready -U pedtv -q; do sleep 1; done

echo "==> Waiting for garage..."
until docker compose exec garage /garage status >/dev/null 2>&1; do sleep 1; done

echo "==> Running migrations..."
docker compose run --rm web python manage.py migrate

echo "==> Creating Garage bucket + enabling public website..."
# (A real file rather than `python -` + heredoc: podman-compose drops the
# trailing "-" arg and lands in an interactive REPL instead.)
docker compose run --rm web python s/create_bucket.py

echo "==> Downloading NHS UK frontend assets..."
mkdir -p "$ROOT/static/nhsuk"
curl -sSf "https://cdn.jsdelivr.net/npm/nhsuk-frontend/dist/nhsuk.min.css" \
     -o "$ROOT/static/nhsuk/nhsuk.min.css"
curl -sSf "https://cdn.jsdelivr.net/npm/nhsuk-frontend/dist/nhsuk.min.js" \
     -o "$ROOT/static/nhsuk/nhsuk.min.js"
echo "    NHS UK frontend assets saved to static/nhsuk/."

echo "==> Creating default providers..."
docker compose run --rm web python manage.py create_providers

echo ""
echo "==> Bootstrap complete."
echo ""
echo "    Next steps:"
echo "      s/manage createsuperuser   — create your first admin account"
echo "      s/up                       — start the full dev stack"
echo "      open http://localhost:8000"
