SECRET_KEY=dev-secret-key-change-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=pedtv
DB_USER=pedtv
DB_PASSWORD=pedtv
DB_HOST=postgres
DB_PORT=5432

# Storage: "s3" (MinIO/Garage locally) or "azure" (production)
STORAGE_BACKEND=s3

# S3 / MinIO settings (dev)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=pedtv-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
# Public host used to build media URLs visible to the browser.
# In dev this must be the host:port exposed by docker-compose (localhost:9000).
# In prod with Azure storage this var is unused.
AWS_S3_PUBLIC_HOST=localhost:9000
AWS_S3_URL_PROTOCOL=http:

# Azure Blob settings (prod - leave blank in dev)
# STORAGE_BACKEND=azure
# AZURE_ACCOUNT_NAME=
# AZURE_ACCOUNT_KEY=
# AZURE_CONTAINER=pedtv-media
