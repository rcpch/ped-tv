# PED TV environment file.
# s/bootstrap copies this to envs/.env; environment variables already set take
# precedence over values in this file.

# --- Core ---
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Set to true in production, where TLS is terminated by a reverse proxy
# (Fastly/nginx) in front of the container, so Django sees the original
# https:// scheme (e.g. in password reset links). Leave false in dev.
SECURE_PROXY_SSL_HEADER=false

# Set to true in production to trust the proxy's X-Forwarded-Host header, so
# absolute URLs (password reset email links) use the public domain instead of
# the internal container app name. Requires Fastly to send X-Forwarded-Host,
# and the public domain to be listed in ALLOWED_HOSTS. Leave false in dev.
USE_X_FORWARDED_HOST=false

# --- Database ---
DB_NAME=pedtv
DB_USER=pedtv
DB_HOST=postgres
DB_PORT=5432
DB_PASSWORD=pedtv
# Authenticate with an Azure Entra ID managed identity token instead of a
# static password (production):
# DB_USE_AAD_TOKEN=true

# --- Email (password reset) ---
# Dev default "console" prints emails to the container logs. In production set
# EMAIL_BACKEND=smtp and configure the relay below.
EMAIL_BACKEND=console
# EMAIL_HOST=smtp.example.nhs.uk
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=10
# Address password reset emails come from:
# DEFAULT_FROM_EMAIL=ped-tv@example.nhs.uk

# --- Object storage ---
# "s3" (Garage locally) or "azure" (production)
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadminminioadmin
AWS_STORAGE_BUCKET_NAME=pedtv-media
AWS_S3_ENDPOINT_URL=http://garage:9000
AWS_S3_REGION_NAME=us-east-1
# Public host used to build media URLs visible to the browser — Garage's
# website endpoint, which serves buckets at <bucket>.<host> without signing.
# In dev this must be the website port exposed by docker-compose (3902).
# In prod with Azure storage this var is unused.
AWS_S3_PUBLIC_HOST=web.garage.localhost:3902
AWS_S3_URL_PROTOCOL=http:
# For Azure Blob Storage instead:
# STORAGE_BACKEND=azure
# AZURE_ACCOUNT_NAME=
# AZURE_ACCOUNT_KEY=
# AZURE_CONTAINER=pedtv-media
# AZURE_CUSTOM_DOMAIN=